<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>वेदायन कौशल विकास केंद्र | Vedayan Skill Academy</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .skill-gradient {
      background: linear-gradient(135deg, #1e3a8a 0%, #0369a1 50%, #0284c7 100%);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur shadow-sm border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        <a href="skills.html" class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl skill-gradient flex items-center justify-center text-white text-2xl shadow-md">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div>
            <span class="block text-lg sm:text-xl font-black text-slate-900 tracking-tight">वेदायन कौशल विकास केंद्र</span>
            <span class="block text-[11px] uppercase tracking-widest text-sky-700 font-bold">Vedayan Skill Academy</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
          <a href="index.html" class="text-amber-800 hover:text-amber-900 flex items-center gap-1.5 font-bold">
            <i class="fa-solid fa-arrow-left"></i> मुख्य आश्रम पोर्टल
          </a>
          <a href="#courses" class="hover:text-sky-700 transition">सभी कोर्सेज</a>
          <a href="#apply" class="hover:text-sky-700 transition">एडमिशन फॉर्म</a>
        </nav>

        <a href="#apply" class="hidden sm:inline-block skill-gradient text-white px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow hover:opacity-95 transition">
          🎓 प्रवेश हेतु आवेदन करें
        </a>
      </div>
    </div>
  </header>

  <!-- Banner -->
  <section class="bg-slate-900 text-white py-16 sm:py-20 text-center px-4">
    <span class="inline-block bg-sky-500/20 text-sky-300 border border-sky-400/30 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold uppercase tracking-wider mb-4">
      🛠️ नाममात्र सहयोग शुल्क • 100% प्रैक्टिकल फील्ड ट्रेनिंग
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold max-w-4xl mx-auto leading-tight">
      "हुनर सीखें, आत्मनिर्भर बनें और समाज को रोजगार दें"
    </h1>
    <p class="mt-4 text-slate-300 max-w-2xl mx-auto text-sm sm:text-base">
      ग्रामीण एवं आर्थिक रूप से कमजोर वर्ग के युवाओं और मातृशक्ति को आधुनिक तकनीकी एवं लघु उद्योग क्षेत्रों में प्रशिक्षित कर स्वावलंबी बनाने का अभियान।
    </p>
  </section>

  <!-- Courses Grid -->
  <section id="courses" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900">उपलब्ध वोकेशनल एवं वोकेशनल ट्रेड्स</h2>
      <p class="text-slate-600 text-sm mt-1">अपनी रुचि के अनुसार कोर्स चुनें:</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-video"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">CCTV कैमरा एवं सिक्योरिटी सिस्टम</h3>
        <p class="text-xs text-slate-600 mt-2">IP, HD कैमरा फिटिंग, DVR/NVR नेटवर्किंग, केबलिंग, मोबाइल लाइव व्यू और फॉल्ट रिपेयरिंग।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-plug"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">इलेक्ट्रिकल वायरिंग एवं मेंटेनेंस</h3>
        <p class="text-xs text-slate-600 mt-2">घरेलू व कमर्शियल वायरिंग, MCB फिटिंग, इन्वर्टर कनेक्शन, स्विच बोर्ड इंस्टॉलेशन।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-scissors"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">ब्यूटी पार्लर एवं मेक-अप आर्ट</h3>
        <p class="text-xs text-slate-600 mt-2">स्किन केयर, हेयर स्टाइलिंग, ब्राइडल मेकअप और पार्लर मैनेजमेंट का पूर्ण प्रशिक्षण।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-shirt"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">सिलाई, कटाई एवं बुनाई कला</h3>
        <p class="text-xs text-slate-600 mt-2">सूट, फैंसी वस्त्र निर्माण, सिलाई मशीन संचालन और बुटीक कार्य।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-desktop"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">कंप्यूटर बेसिक एवं टाइपिंग</h3>
        <p class="text-xs text-slate-600 mt-2">Windows, MS Office, हिंदी-अंग्रेजी टाइपिंग, इंटरनेट, ईमेल और डिजिटल अकाउंटिंग।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-tv"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">स्मार्ट TV एवं एप्लायंस रिपेयरिंग</h3>
        <p class="text-xs text-slate-600 mt-2">LED TV पैनल चेकिंग, बैकलाइट फॉल्ट, कार्ड लेवल रिपेयरिंग और इलेक्ट्रॉनिक्स मेंटेनेंस।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-camera"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">फोटो एवं वीडियोग्राफी</h3>
        <p class="text-xs text-slate-600 mt-2">DSLR कैमरा संचालन, इवेंट शूटिंग, लाइटिंग और एडिटिंग का व्यावहारिक ज्ञान।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-print"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">ज़ेरॉक्स, लैमिनेशन व ऑनलाइन CSC</h3>
        <p class="text-xs text-slate-600 mt-2">फोटोकॉपी, ऑनलाइन फॉर्म्स और सरकारी सेवा केंद्र संचालन प्रशिक्षण।</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-yellow-100 text-yellow-700 flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-gem"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">हैंडमेड ज्वेलरी एवं लघु उद्योग</h3>
        <p class="text-xs text-slate-600 mt-2">आर्टिफिशियल गहना निर्माण, क्राफ्ट मेकिंग और घरेलू स्तर पर पैकेजिंग उद्योग।</p>
      </div>

    </div>
  </section>

  <!-- Admission Form -->
  <section id="apply" class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-slate-900">प्रवेश / जानकारी फॉर्म</h2>
        <p class="text-xs text-slate-500 mt-1">कोर्स में दाखिले के लिए अपनी जानकारी भरें:</p>
      </div>

      <form onsubmit="event.preventDefault(); alert('धन्यवाद! आपका आवेदन प्राप्त हो गया है। टीम शीघ्र संपर्क करेगी।'); this.reset();" class="space-y-4 bg-slate-50 p-6 sm:p-8 rounded-2xl border border-slate-200 text-sm">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">पूरा नाम *</label>
          <input type="text" required placeholder="अपना नाम लिखें" class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">मोबाइल नंबर *</label>
            <input type="tel" required placeholder="10 अंकों का नंबर" class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">कोर्स चुनें *</label>
            <select required class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
              <option value="">-- कोर्स सेलेक्ट करें --</option>
              <option>CCTV कैमरा तकनीशियन</option>
              <option>इलेक्ट्रिकल वायरिंग</option>
              <option>ब्यूटी पार्लर एवं मेक-अप</option>
              <option>सिलाई एवं बुनाई</option>
              <option>कंप्यूटर बेसिक</option>
              <option>स्मार्ट TV रिपेयरिंग</option>
              <option>फोटो/वीडियोग्राफी</option>
              <option>ज़ेरॉक्स व CSC</option>
              <option>ज्वेलरी मेकिंग</option>
            </select>
          </div>
        </div>
        <button type="submit" class="w-full skill-gradient text-white font-bold py-3 rounded-lg shadow mt-2">
          आवेदन सबमिट करें
        </button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 text-xs py-8 text-center border-t border-slate-800">
    <p>वेदायन कौशल विकास केंद्र | वेदायन ट्रस्ट का स्वावलंबन मिशन | संस्थापक: अनिल</p>
    <a href="index.html" class="text-amber-400 underline mt-2 inline-block">← मुख्य आश्रम पोर्टल पर वापस जाएँ</a>
  </footer>

</body>
</html>
