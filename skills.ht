<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>वेदायन कौशल विकास केंद्र | Vedayan Skill Academy - हुनर से आत्मनिर्भरता</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .skill-gradient {
      background: linear-gradient(135deg, #1e3a8a 0%, #0369a1 50%, #0284c7 100%);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

  <!-- ================= TOP HEADER ================= -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur shadow-sm border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        
        <!-- Academy Brand -->
        <a href="skills.html" class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl skill-gradient flex items-center justify-center text-white text-2xl shadow-md">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div>
            <span class="block text-lg sm:text-xl font-black text-slate-900 tracking-tight">वेदायन कौशल विकास केंद्र</span>
            <span class="block text-[11px] uppercase tracking-widest text-sky-700 font-bold">Vedayan Skill Academy</span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
          <a href="index.html" class="text-amber-800 hover:text-amber-900 flex items-center gap-1.5">
            <i class="fa-solid fa-arrow-left"></i> मुख्य आश्रम वेबसाइट
          </a>
          <a href="#courses" class="hover:text-sky-700 transition">सभी कोर्सेज</a>
          <a href="#mission" class="hover:text-sky-700 transition">हमारा विजन</a>
          <a href="#apply" class="hover:text-sky-700 transition">एडमिशन फॉर्म</a>
        </nav>

        <div class="hidden sm:flex items-center gap-3">
          <a href="#apply" class="skill-gradient text-white px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow hover:opacity-95 transition">
            🎓 प्रवेश हेतु आवेदन करें
          </a>
        </div>

        <button onclick="toggleMobileMenu()" class="md:hidden text-slate-700 text-2xl p-2">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="hidden md:hidden bg-white border-b border-slate-200 px-4 py-4 space-y-3 text-sm font-medium">
      <a href="index.html" class="block py-1 text-amber-800 font-bold">← मुख्य आश्रम वेबसाइट</a>
      <a href="#courses" onclick="toggleMobileMenu()" class="block py-1 text-slate-700">सभी कोर्सेज</a>
      <a href="#mission" onclick="toggleMobileMenu()" class="block py-1 text-slate-700">हमारा विजन</a>
      <a href="#apply" onclick="toggleMobileMenu()" class="block py-1 text-slate-700">एडमिशन फॉर्म</a>
      <a href="#apply" onclick="toggleMobileMenu()" class="inline-block w-full text-center skill-gradient text-white py-2 rounded-lg font-bold">प्रवेश हेतु आवेदन</a>
    </div>
  </header>

  <!-- ================= HERO BANNER ================= -->
  <section class="relative bg-slate-900 text-white py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-flex items-center gap-2 bg-sky-500/20 text-sky-300 border border-sky-400/30 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold uppercase tracking-wider mb-6">
        🛠️ नाममात्र सहयोग शुल्क • 100% प्रैक्टिकल फील्ड ट्रेनिंग
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight">
        "हुनर सीखें, आत्मनिर्भर बनें और समाज को रोजगार दें"
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
        <strong>वेदायन कौशल विकास केंद्र</strong> ग्रामीण एवं आर्थिक रूप से कमजोर वर्ग के युवाओं और मातृशक्ति को आधुनिक तकनीकी, वोकेशनल एवं लघु उद्योग क्षेत्रों में प्रशिक्षित कर स्वावलंबी बनाने का महा-अभियान है।
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#apply" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold px-8 py-3.5 rounded-full shadow-lg transition text-sm sm:text-base">
          दाखिला / इंक्वायरी फॉर्म भरें
        </a>
        <a href="#courses" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-8 py-3.5 rounded-full backdrop-blur transition text-sm sm:text-base">
          सभी 10+ कोर्सेज की लिस्ट
        </a>
      </div>
    </div>
  </section>

  <!-- ================= ACADEMY VISION & ESSAY ================= -->
  <section id="mission" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-sky-700 font-bold text-xs uppercase tracking-widest">हमारा संकल्प</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">डिग्री के साथ हाथों में हुनर की शक्ति</h2>
      </div>

      <div class="bg-slate-50 rounded-2xl p-6 sm:p-10 border border-slate-200 space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
        <p>
          आज का युवा केवल डिग्रियों की भीड़ में अपनी पहचान तलाश रहा है, जबकि आज के बदलते परिवेश में व्यावहारिक कौशल (Practical Skills) और स्वावलंबन की सबसे अधिक आवश्यकता है। किसी भी युवा को केवल सहारा देना पर्याप्त नहीं है, बल्कि उसके हाथों में ऐसा हुनर देना आवश्यक है जिससे वह जीवन भर सम्मान के साथ अपनी आजीविका चला सके।
        </p>
        <p>
          <strong>वेदायन ट्रस्ट</strong> के तत्वावधान में स्थापित यह केंद्र युवाओं और बहनों को न केवल काम सिखाता है, बल्कि उन्हें स्थानीय स्तर पर अपना छोटा व्यवसाय (लघु उद्योग), शॉप या रिपेयरिंग सेंटर स्थापित करने के लिए पूर्ण मार्गदर्शन और टूल्स का व्यावहारिक ज्ञान भी प्रदान करता है।
        </p>
      </div>
    </div>
  </section>

  <!-- ================= DETAILED COURSES GRID ================= -->
  <section id="courses" class="py-16 sm:py-24 bg-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-sky-700 font-bold text-xs uppercase tracking-widest">ट्रेनिंग प्रोग्राम्स</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-1">उपलब्ध वोकेशनल एवं वोकेशनल ट्रेड्स</h2>
        <p class="mt-2 text-slate-600 text-sm">अपनी रुचि के अनुसार कोर्स चुनें और फील्ड में कुशल बनें:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Course 1 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-video"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">CCTV कैमरा एवं सिक्योरिटी सिस्टम</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            IP, HD कैमरा फिटिंग, DVR/NVR नेटवर्किंग, केबल क्रिम्पिंग, मोबाइल लाइव व्यू और साइट फॉल्ट रिपेयरिंग।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 45 दिन</span>
            <span class="text-sky-700">फील्ड प्रैक्टिकल</span>
          </div>
        </div>

        <!-- Course 2 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-plug"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">इलेक्ट्रिकल वायरिंग एवं मेंटेनेंस</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            घरेलू व कमर्शियल कंसील्ड वायरिंग, MCB बॉक्स, इन्वर्टर कनेक्शन, स्विच बोर्ड इंस्टॉलेशन व सुरक्षा नियम।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 60 दिन</span>
            <span class="text-amber-700">इलेक्ट्रिकल लैब</span>
          </div>
        </div>

        <!-- Course 3 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-scissors"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">ब्यूटी पार्लर एवं मेक-अप आर्ट</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            स्किन केयर, हेयर स्टाइलिंग, फेशियल, ब्राइडल मेकअप, मेहंदी और प्रोफेशनल पार्लर सेटअप गाइडेंस।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>मातृशक्ति विशेष</span>
            <span class="text-rose-700">स्वरोजगार हब</span>
          </div>
        </div>

        <!-- Course 4 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-shirt"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">सिलाई, कटाई एवं बुनाई कला</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            सूट, ब्लाउज, फैंसी परिधानों की सटीक कटिंग, सिलाई मशीन संचालन, कढ़ाई और बुटीक संचालन का प्रशिक्षण।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 60 दिन</span>
            <span class="text-purple-700">गृह उद्योग</span>
          </div>
        </div>

        <!-- Course 5 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-desktop"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">कंप्यूटर बेसिक एवं ऑफिस ऑटोमेशन</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Windows, MS Office (Word, Excel), हिंदी-अंग्रेजी टाइपिंग, इंटरनेट, ईमेल, और डिजिटल बिलिंग।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 60 दिन</span>
            <span class="text-emerald-700">प्रैक्टिकल लैब</span>
          </div>
        </div>

        <!-- Course 6 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-camera"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">फोटो एवं वीडियोग्राफी</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            DSLR कैमरा संचालन, स्टूडियो व आउटडोर लाइटिंग, वेडिंग/इवेंट कवरेज और बेसिक फोटो-वीडियो एडिटिंग।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 45 दिन</span>
            <span class="text-indigo-700">स्टूडियो अनुभव</span>
          </div>
        </div>

        <!-- Course 7 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-print"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">ज़ेरॉक्स, लैमिनेशन व ऑनलाइन CSC</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            फोटोकॉपी, लैमिनेशन मशीन, ऑनलाइन सरकारी फॉर्म भरना, पासपोर्ट साइज फोटो व ग्राहक सेवा केंद्र ट्रेनिंग।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 30 दिन</span>
            <span class="text-teal-700">शॉप मॉडल</span>
          </div>
        </div>

        <!-- Course 8 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-tv"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">स्मार्ट TV एवं एप्लायंस तकनीशियन</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            LED/Smart TV पैनल चेकिंग, बैकलाइट फॉल्ट, पावर सप्लाई बोर्ड रिपेयरिंग और होम एप्लायंसेज मेंटेनेंस।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 45 दिन</span>
            <span class="text-cyan-700">सर्किट लेवल</span>
          </div>
        </div>

        <!-- Course 9 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-yellow-100 text-yellow-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-gem"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">हैंडमेड ज्वेलरी एवं क्राफ्ट मेकिंग</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            कुंदन, मोती और फैब्रिक से आर्टिफिशियल आभूषण निर्माण, राखी/तोश क्राफ्ट और घरेलू स्तर पर पैकेजिंग।
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-[11px] font-semibold text-slate-500">
            <span>अवधि: 30 दिन</span>
            <span class="text-yellow-700">लघु उद्योग</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ================= ADMISSION / INQUIRY FORM ================= -->
  <section id="apply" class="py-16 sm:py-24 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-10">
        <span class="text-sky-700 font-bold text-xs uppercase tracking-widest">प्रवेश फॉर्म</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">कोर्स में दाखिले या जानकारी के लिए आवेदन</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">फॉर्म भरें, हमारी टीम आपको बैच समय और आवश्यक टूल्स की जानकारी देगी।</p>
      </div>

      <div class="bg-slate-50 p-6 sm:p-10 rounded-3xl border border-slate-200 shadow-sm">
        <form onsubmit="handleApplySubmit(event)" class="space-y-4 text-sm">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">विद्यार्थी / आवेदक का नाम *</label>
              <input type="text" required placeholder="पूरा नाम लिखें" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:border-sky-600 bg-white">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">मोबाइल नंबर (WhatsApp) *</label>
              <input type="tel" required placeholder="10 अंकों का नंबर" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:border-sky-600 bg-white">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">आपकी आयु एवं शहर/गांव *</label>
              <input type="text" required placeholder="उदा. 22 वर्ष, पुणे / गांव का नाम" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:border-sky-600 bg-white">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">पसंदीदा ट्रेड / कोर्स चुनें *</label>
              <select required class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:border-sky-600 bg-white">
                <option value="">-- कोर्स सेलेक्ट करें --</option>
                <option value="cctv">CCTV कैमरा एवं सिक्योरिटी सिस्टम</option>
                <option value="electrical">इलेक्ट्रिकल एवं वायरिंग तकनीक</option>
                <option value="beauty">ब्यूटी पार्लर एवं मेकअप आर्ट</option>
                <option value="sewing">सिलाई, कटाई एवं बुनाई</option>
                <option value="computer">कंप्यूटर बेसिक एवं टाइपिंग</option>
                <option value="tv">स्मार्ट TV रिपेयरिंग</option>
                <option value="media">फोटो एवं वीडियोग्राफी</option>
                <option value="xerox">ज़ेरॉक्स, लैमिनेशन व ऑनलाइन CSC</option>
                <option value="jewelry">ज्वेलरी मेकिंग व लघु उद्योग</option>
                <option value="plumbing">प्लंबिंग एवं मोटर फिटिंग</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">कोई सवाल या पूर्व अनुभव (वैकल्पिक)</label>
            <textarea rows="3" placeholder="अगर आपने पहले थोड़ा बहुत काम सीखा है या कोई सवाल है तो यहाँ लिखें..." class="w-full border border-slate-300 rounded-lg p-2.5 outline-none focus:border-sky-600 bg-white"></textarea>
          </div>

          <button type="submit" class="w-full skill-gradient text-white font-bold py-3.5 rounded-xl shadow hover:opacity-95 transition text-base">
            प्रवेश फॉर्म सबमिट करें (Submit Application)
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="bg-slate-900 text-slate-400 text-xs py-10 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <div>
        <strong class="text-white">वेदायन कौशल विकास केंद्र (Vedayan Skill Academy)</strong>
        <p class="text-[11px] text-slate-500 mt-0.5">वेदायन ट्रस्ट (Vedayan Trust) का स्वावलंबन प्रकल्प | संस्थापक: अनिल</p>
      </div>
      <div class="flex gap-4">
        <a href="index.html" class="text-amber-400 hover:underline">← मुख्य आश्रम पोर्टल</a>
        <a href="#courses" class="hover:text-white">कोर्सेज</a>
        <a href="#apply" class="hover:text-white">एडमिशन</a>
      </div>
    </div>
  </footer>

  <script>
    function toggleMobileMenu() {
      document.getElementById('mobileMenu').classList.toggle('hidden');
    }
    function handleApplySubmit(e) {
      e.preventDefault();
      alert("धन्यवाद! आपका प्रवेश आवेदन प्राप्त हो गया है। वेदायन कौशल केंद्र की टीम आपसे शीघ्र ही संपर्क करेगी।");
      e.target.reset();
    }
  </script>

</body>
</html>
